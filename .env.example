DJANGO_SECRET_KEY=changeme-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (reference database). DB_NAME, DB_USER and DB_PASSWORD are required.
DB_NAME=scheduling
DB_USER=scheduling
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
# Seconds a connection is kept open between requests (0 = close after each request)
DB_CONN_MAX_AGE=60

# Root directory on the server where shared datasets live (optional)
SERVER_DIR=

# Default local paths for scheduling input files
MPP_PATH=dataset.mpp
XLSX_PATH=jobs.xlsx

# Scheduling and optimization runtime settings
PENALE_MAX=5
SOLVER_TIME_LIMIT=10
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=90
MSP_DISPATCH_RETRY_INTERVAL_SECONDS=0.5
MSP_DISPATCH_RETRY_MAX_WAIT_SECONDS=5.0
AUTO_IMPORT_ON_STARTUP=true

# OpenAI configuration
OPENAI_API_KEY=your-openai-api-key
# Model reading the WPS PDF (bore dimensions and tube pitch)
OPENAI_WPS_MODEL=gpt-5.6-sol
# Model behind the optimization explanation agent
OPENAI_MODEL=gpt-5.4-mini
